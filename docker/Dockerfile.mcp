FROM python:3.15-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir ".[mcp]" \
    && addgroup -g 65532 -S nxtflow \
    && adduser -u 65532 -G nxtflow -S -D -H nxtflow

USER 65532:65532

EXPOSE 8000

ENTRYPOINT ["nxtflow-mcp"]
CMD ["--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8000"]
