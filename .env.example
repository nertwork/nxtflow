# nxtflow Standalone Docker Compose Configuration
# Copy to .env (`cp .env.example .env`) and customize ports or site settings.

# --- Collector & Loki Labels ---
# Site label attached to Loki streams: {job, site, dir}
NXTFLOW_SITE=default
# Loki job label (must match Grafana dashboard and nxtflow CLI/MCP NXTFLOW_JOB)
NXTFLOW_JOB=nxtflow
NXTFLOW_LOG_LEVEL=INFO

# --- Container Image Tag (used for ghcr.io/nertwork/nxtflow-{enricher,mcp}) ---
NXTFLOW_IMAGE_TAG=latest

# --- Host Bind & Exposed Ports ---
# Use 0.0.0.0 to accept LAN router exports, or 127.0.0.1 for local-only access
NXTFLOW_BIND_IP=0.0.0.0

# NetFlow v5/v9/IPFIX UDP listener port
NXTFLOW_NETFLOW_PORT=2055
# sFlow v5 UDP listener port
NXTFLOW_SFLOW_PORT=6343

# Grafana UI port (change if 3000 is already in use, e.g. 3030)
NXTFLOW_GRAFANA_PORT=3000
# Loki HTTP API port (used by nxtflow CLI and external MCP clients)
NXTFLOW_LOKI_PORT=3100
# Prometheus UI port (9091 avoids colliding with enricher metrics on 9090)
NXTFLOW_PROMETHEUS_PORT=9091
# Enricher HTTP ingest & health port (/ingest, /healthz, /readyz)
NXTFLOW_ENRICHER_HTTP_PORT=8081
# Enricher Prometheus metrics port (/metrics)
NXTFLOW_ENRICHER_METRICS_PORT=9090
# GoFlow2 Prometheus metrics port (/metrics)
NXTFLOW_GOFLOW2_METRICS_PORT=8080
# nxtflow-mcp streamable-http port (/mcp, /healthz)
NXTFLOW_MCP_PORT=8000

# --- Grafana Credentials & Access ---
NXTFLOW_GRAFANA_ADMIN_USER=admin
NXTFLOW_GRAFANA_ADMIN_PASSWORD=nxtflow
NXTFLOW_GRAFANA_ANONYMOUS_ENABLED=false

# --- Loki Retention ---
NXTFLOW_LOKI_RETENTION=168h

# --- Optional NetBox IPAM Enrichment ---
NXTFLOW_NETBOX_ENABLED=false
NXTFLOW_NETBOX_URL=
NXTFLOW_NETBOX_TOKEN=
NXTFLOW_NETBOX_TLS_VERIFY=true

# --- Synthetic Demo Flow Generator (--profile demo) ---
NXTFLOW_DEMO_PROTOCOL=netflow9
NXTFLOW_DEMO_INTERVAL=2
NXTFLOW_DEMO_BATCH_SIZE=12
