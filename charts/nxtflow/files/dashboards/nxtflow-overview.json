    {
      "id": 14,
      "title": "Traffic Flow",
      "type": "volkovlabs-echarts-panel",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "topk(25, sum by (src_host, dst_host) (sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", src_host=\"src_host\", dst_host=\"dst_host\" | src_host != `multicast` | src_host != `link-local` | src_host != `` | dst_host != `multicast` | dst_host != `link-local` | dst_host != `` | unwrap flow_bytes [$__range])))",
          "refId": "A",
          "format": "table",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "renderer": "canvas",
        "editor": {
          "format": "auto"
        },
        "getOption": "const series = context.panel.data.series || [];\nif (!series.length) {\n  return {\n    title: {\n      text: \"No flow data in selected range\",\n      left: \"center\",\n      top: \"middle\",\n      textStyle: { color: \"#94a3b8\", fontSize: 14, fontWeight: \"normal\" }\n    }\n  };\n}\nconst frame = series[0];\nconst fields = frame.fields || [];\nconst srcField = fields.find((f) => f.name === \"src_host\");\nconst dstField = fields.find((f) => f.name === \"dst_host\");\nconst valField = fields.find((f) => f.name === \"Value\" || f.type === \"number\");\nif (!srcField || !dstField || !valField) {\n  return {};\n}\nconst len = valField.values.length;\nconst nodeMap = new Map();\nconst links = [];\nconst fmtBytes = (b) => {\n  const units = [\"B\", \"KiB\", \"MiB\", \"GiB\", \"TiB\"];\n  let v = Number(b) || 0;\n  let i = 0;\n  while (v >= 1024 && i < units.length - 1) { v /= 1024; i += 1; }\n  return v.toFixed(1) + \" \" + units[i];\n};\nfor (let i = 0; i < len; i += 1) {\n  const sRaw = String(srcField.values[i] || \"\");\n  const dRaw = String(dstField.values[i] || \"\");\n  const val = Number(valField.values[i] || 0);\n  if (!sRaw || !dRaw || val <= 0) continue;\n  const sId = \"s:\" + sRaw;\n  const dId = \"d:\" + dRaw;\n  if (!nodeMap.has(sId)) nodeMap.set(sId, { name: sId, itemStyle: { color: \"#38bdf8\" } });\n  if (!nodeMap.has(dId)) nodeMap.set(dId, { name: dId, itemStyle: { color: \"#818cf8\" } });\n  links.push({ source: sId, target: dId, value: val });\n}\nconst stripPrefix = (n) => String(n || \"\").replace(/^[sd]:/, \"\");\nreturn {\n  tooltip: {\n    trigger: \"item\",\n    triggerOn: \"mousemove\",\n    formatter: (params) => {\n      if (params.dataType === \"edge\") {\n        return stripPrefix(params.data.source) + \" -> \" + stripPrefix(params.data.target) + \": <b>\" + fmtBytes(params.data.value) + \"</b>\";\n      }\n      return stripPrefix(params.name) + \": <b>\" + fmtBytes(params.value) + \"</b>\";\n    }\n  },\n  series: [\n    {\n      type: \"sankey\",\n      nodeAlign: \"justify\",\n      nodeWidth: 16,\n      nodeGap: 10,\n      draggable: false,\n      data: Array.from(nodeMap.values()),\n      links,\n      lineStyle: { color: \"gradient\", curveness: 0.5, opacity: 0.45 },\n      label: {\n        color: \"#e2e8f0\",\n        fontSize: 11,\n        formatter: (params) => stripPrefix(params.name)\n      }\n    }\n  ]\n};"
      }
    },
