{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki datasource storing nxtflow telemetry",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping nxtflow-enricher metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "nxtflow-overview",
  "title": "Network Traffic Overview",
  "tags": [
    "nxtflow",
    "netflow",
    "networking"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "label_values({job=\"nxtflow\"}, site)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "site",
        "label": "Site",
        "type": "query",
        "query": {
          "label": "site",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"nxtflow\"}",
          "type": 1
        },
        "refresh": 2,
        "sort": 1,
        "options": []
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "up|down|lan",
        "name": "dir",
        "label": "Direction",
        "type": "custom",
        "query": "up : Upload,down : Download,lan : Internal",
        "options": []
      },
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Download",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=\"down\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [$__range])) / $__range_s * 8",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "noValue": "0 bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80000000
              },
              {
                "color": "red",
                "value": 800000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "title": "Upload",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=\"up\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [$__range])) / $__range_s * 8",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "noValue": "0 bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80000000
              },
              {
                "color": "red",
                "value": 800000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Total Traffic",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [$__range])) * 8",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bits",
          "decimals": 1,
          "noValue": "0 b",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8000000000
              },
              {
                "color": "red",
                "value": 80000000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Collector",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(up{service=~\".*nxtflow.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Bandwidth (2m Smoothed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "15s",
      "targets": [
        {
          "expr": "sum(rate({job=\"nxtflow\", site=~\"$site\", dir=\"down\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [2m])) * 8",
          "legendFormat": "Download",
          "refId": "A"
        },
        {
          "expr": "sum(rate({job=\"nxtflow\", site=~\"$site\", dir=\"up\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [2m])) * 8",
          "legendFormat": "Upload",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 25,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Download"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upload"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 18,
      "title": "Bandwidth by Site & Direction (2m Smoothed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "15s",
      "targets": [
        {
          "expr": "sum by (site) (rate({job=\"nxtflow\", site=~\"$site\", dir=\"down\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [2m])) * 8",
          "legendFormat": "{{site}} \u2193 Down",
          "refId": "A"
        },
        {
          "expr": "sum by (site) (rate({job=\"nxtflow\", site=~\"$site\", dir=\"up\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [2m])) * 8",
          "legendFormat": "{{site}} \u2191 Up",
          "refId": "B"
        },
        {
          "expr": "sum by (site) (rate({job=\"nxtflow\", site=~\"$site\", dir=\"lan\"} |~ `$search` | json flow_bytes=\"bytes\" | unwrap flow_bytes [2m])) * 8",
          "legendFormat": "{{site}} \u2194 LAN",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Traffic by Destination (2m Smoothed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "15s",
      "targets": [
        {
          "expr": "topk(8, sum by (dst_host) (rate({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", dst_host=\"dst_host\" | dst_host != `multicast` | dst_host != `link-local` | dst_host != `` | unwrap flow_bytes [2m]))) * 8",
          "legendFormat": "{{dst_host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 19,
      "title": "Traffic by Destination (Relative %)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 9,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "15s",
      "targets": [
        {
          "expr": "topk(8, sum by (dst_host) (rate({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", dst_host=\"dst_host\" | dst_host != `multicast` | dst_host != `link-local` | dst_host != `` | unwrap flow_bytes [2m]))) * 8",
          "legendFormat": "{{dst_host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 50,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "percent",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Protocol Mix",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "1m",
      "targets": [
        {
          "expr": "sum by (proto) (sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", proto=\"proto\" | unwrap flow_bytes [$__range])) * 8",
          "legendFormat": "{{proto}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bits"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Top Sources",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "1m",
      "targets": [
        {
          "expr": "topk(10, sum by (src_host) (sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", src_host=\"src_host\" | src_host != `multicast` | src_host != `link-local` | src_host != `` | unwrap flow_bytes [$__range]))) * 8",
          "legendFormat": "{{src_host}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 10
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last *"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bits"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "namePlacement": "auto"
      }
    },
    {
      "id": 8,
      "title": "Top Destinations",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "interval": "1m",
      "targets": [
        {
          "expr": "topk(10, sum by (dst_host) (sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", dst_host=\"dst_host\" | dst_host != `multicast` | dst_host != `link-local` | dst_host != `` | unwrap flow_bytes [$__range]))) * 8",
          "legendFormat": "{{dst_host}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 10
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last *"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bits"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "namePlacement": "auto"
      }
    },
    {
      "id": 9,
      "title": "Top Connections",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "topk(25, sum by (src_host, dst_host) (sum_over_time({job=\"nxtflow\", site=~\"$site\", dir=~\"$dir\"} |~ `$search` | json flow_bytes=\"bytes\", src_host=\"src_host\", dst_host=\"dst_host\" | src_host != `multicast` | src_host != `link-local` | src_host != `` | dst_host != `multicast` | dst_host != `link-local` | dst_host != `` | unwrap flow_bytes [$__range]))) * 8",
          "refId": "A",
          "format": "table",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter: ${__value.text}",
                    "url": "/d/nxtflow-overview/network-traffic-overview?var-site=${site}&var-dir=${dir}&var-search=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Destination"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter: ${__value.text}",
                    "url": "/d/nxtflow-overview/network-traffic-overview?var-site=${site}&var-dir=${dir}&var-search=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Traffic",
            "desc": true
          }
        ]
      },
